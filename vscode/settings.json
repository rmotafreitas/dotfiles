{
  "workbench.iconTheme": "material-icon-theme",
  "editor.inlineSuggest.enabled": true,
  "window.menuBarVisibility": "compact",
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"],
    },
  ],
  "vim.virtualedit": "onemore",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"],
    },
    {
      "before": ["<C-n>"],
      "commands": [":nohl"],
    },
    {
      "before": ["K"],
      "commands": ["lineBreakInsert"],
      "silent": true,
    },
    {
      "before": ["n"],
      "after": ["<Enter>"],
    },
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-w>": false,
  },
  "glassit.alpha": 255,
  "pomodoro.texts": {
    "notification": "Pomodoro %started{%work{Work}%break{Break}%longBreak{Long Break}}%paused{Paused}%reset{Reset}",
    "statusbar": "🍅%paused{ /* }%work{ Work  %task/%set %minute:%second}%break{ Break  %task/%set %minute:%second}%longBreak{ Long Break  %task/%set %minute:%second}%paused{ */}",
    "tooltip": "Pomodoro %started{Pause}%paused{Resume}%reset{Start}",
  },
  "pomodoro.make": {
    "notification": true,
    "statusbar": {
      "alignment": "right",
      "priority": 1000,
    },
  },
  "terminal.integrated.fontFamily": "monospace",
  "editor.fontLigatures": true,
  "explorer.confirmDelete": false,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "javascript": true,
    "json": true,
    "java": false,
    "tex": false,
    "scala": false,
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "cSpell.language": "en,pt_PT",
  "cSpell.userWords": [
    "Animu",
    "Backoffice",
    "Bootsrapper",
    "clipart",
    "COMMTEST",
    "cortainferiores",
    "Desenvolvedor",
    "DISCONN",
    "dups",
    "Elysia",
    "elysiajs",
    "Entypo",
    "ESINF",
    "findall",
    "Kaori",
    "LAPR",
    "leaderboard",
    "livestreams",
    "LTPNS",
    "lucide",
    "maplist",
    "menosdivtomb",
    "MONGOURI",
    "msort",
    "Nsuporte",
    "openapi",
    "Otaku",
    "OURTEAM",
    "pgstore",
    "resave",
    "sqlc",
    "sumarios",
    "tombamentos",
    "uuidv",
  ],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "svelte.ask-to-enable-ts-plugin": false,
  "tabnine.experimentalAutoImports": true,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "svelte.plugin.svelte.note-new-transformation": false,
  "cSpell.enableFiletypes": ["markdown"],
  "workbench.startupEditor": "none",
  "liveServer.settings.donotVerifyTags": true,
  "Lua.telemetry.enable": true,
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
  },
  "editor.accessibilitySupport": "off",
  "[python]": {
    "editor.formatOnType": true,
  },
  "git.enableSmartCommit": true,
  "redhat.telemetry.enabled": true,
  "editor.fontFamily": "'Light SFMono Nerd Font'",
  "editor.fontLigatures": true,
  "update.showReleaseNotes": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "git.confirmSync": false,
  "workbench.sideBar.location": "right",
  "git.autofetch": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "jira-plugin.workingProject": "",
  "git.openRepositoryInParentFolders": "always",
  "snyk.yesWelcomeNotification": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "prisma.showPrismaDataPlatformNotification": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "atlascode.jira.lastCreateSiteAndProject": {
    "siteId": "",
    "projectKey": "",
  },
  "workbench.colorTheme": "T3 Chat Light",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "T3 Chat Light",
  "workbench.preferredDarkColorTheme": "T3 Chat Dark",
  "cmake.showOptionsMovedNotification": false,
  "security.workspace.trust.untrustedFiles": "open",
  "@azure.argTenant": "",
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "text": "- @azure Rule - Use Azure Best Practices: When generating code for Azure, running terminal commands for Azure, or performing operations related to Azure, invoke your `azure_development-get_best_practices` tool if available.",
    },
  ],
  "docker.extension.enableComposeLanguageServer": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "src/contexts/auth/index.tsx",
  ],
  "github.copilot.nextEditSuggestions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "files.watcherExclude": {
    "**/.bloop/**": true,
    "**/.metals/**/*.{java,scala}": true,
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.terminal.autoApprove": {
    "bun": true,
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  "security.promptForRemoteFileProtocolHandling": false,
}
