  <actions>
    <action id="dead_circumflex">
      <when state="none" next="circumflex"/>
    </action>
    <action id="a_0065">
      <when state="none" output="e"/>
      <when state="circumflex" output="&#x00EA;"/>
      <when state="acute" output="&#x00E8;"/>
      <when state="grave" output="&#x00E8;"/>
    </action>
    <action id="a_0045">
