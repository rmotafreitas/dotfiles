    key <AD08> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ i, I, iacute, Iacute ] };  // i I í Í
    key <AD09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ o, O, oacute, Oacute ] };  // o O ó Ó
    key <AD10> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ p, P, odiaeresis, Odiaeresis ] };  // p P ö Ö
    key <AD11> { type[Group1] = "FOUR_LEVEL", [ bracketleft, braceleft, guillemotleft, NoSymbol ] };  // [ { « -
    key <AD12> { type[Group1] = "FOUR_LEVEL", [ bracketright, braceright, guillemotright, NoSymbol ] };  // ] } » -
    key <AC01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ a, A, aacute, Aacute ] };  // a A á Á
    key <AC02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ s, S, ssharp, section ] };  // s S ß §
