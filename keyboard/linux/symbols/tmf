    key <AC04> { type[Group1] = "ALPHABETIC", [ f, F ] };  // f F - -
    key <AC05> { type[Group1] = "ALPHABETIC", [ g, G ] };  // g G - -
    key <AC06> { type[Group1] = "ALPHABETIC", [ h, H ] };  // h H - -
    key <AC07> { type[Group1] = "ALPHABETIC", [ j, J ] };  // j J - -
    key <AC08> { type[Group1] = "ALPHABETIC", [ k, K ] };  // k K - -
    key <AC09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ l, L, oslash, Ooblique ] };  // l L ø Ø
    key <AC10> { type[Group1] = "FOUR_LEVEL", [ semicolon, colon, masculine, ordfeminine ] };  // ; : º ª
