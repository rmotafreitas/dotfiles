// TMF Keyboard - generated from a Microsoft KLC file by klc2xkb.py
// Install: ~/.config/xkb/symbols/<this file name> (see README).
// AltGr = Right Alt. Dead keys: Shift+6 (^), Shift+` (~), ` (grave), AltGr+' (grave).
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    include "level3(ralt_switch)"
    name[Group1] = "TMF Keyboard";

    key <AE01> { type[Group1] = "FOUR_LEVEL", [ 1, exclam, exclamdown, onesuperior ] };  // 1 ! ¡ ¹
    key <AE02> { type[Group1] = "FOUR_LEVEL", [ 2, at, twosuperior, NoSymbol ] };  // 2 @ ² -
    key <AE03> { type[Group1] = "FOUR_LEVEL", [ 3, numbersign, threesuperior, NoSymbol ] };  // 3 # ³ -
    key <AE04> { type[Group1] = "FOUR_LEVEL", [ 4, dollar, currency, sterling ] };  // 4 $ ¤ £
    key <AE05> { type[Group1] = "FOUR_LEVEL", [ 5, percent, EuroSign, NoSymbol ] };  // 5 % € -
    key <AE06> { type[Group1] = "FOUR_LEVEL", [ 6, dead_circumflex, onequarter, NoSymbol ] };  // 6 ^ ¼ -
    key <AE07> { type[Group1] = "FOUR_LEVEL", [ 7, ampersand, onehalf, NoSymbol ] };  // 7 & ½ -
    key <AE08> { type[Group1] = "FOUR_LEVEL", [ 8, asterisk, threequarters, NoSymbol ] };  // 8 * ¾ -
    key <AE09> { type[Group1] = "FOUR_LEVEL", [ 9, parenleft, leftsinglequotemark, NoSymbol ] };  // 9 ( ‘ -
    key <AE10> { type[Group1] = "FOUR_LEVEL", [ 0, parenright, rightsinglequotemark, NoSymbol ] };  // 0 ) ’ -
    key <AE11> { type[Group1] = "FOUR_LEVEL", [ minus, underscore, yen, NoSymbol ] };  // - _ ¥ -
    key <AE12> { type[Group1] = "FOUR_LEVEL", [ equal, plus, multiply, division ] };  // = + × ÷
    key <AD01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ q, Q, adiaeresis, Adiaeresis ] };  // q Q ä Ä
    key <AD02> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ w, W, aring, Aring ] };  // w W å Å
    key <AD03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ e, E, eacute, Eacute ] };  // e E é É
    key <AD04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ r, R, registered, NoSymbol ] };  // r R ® -
    key <AD05> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ t, T, thorn, THORN ] };  // t T þ Þ
    key <AD06> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ y, Y, udiaeresis, Udiaeresis ] };  // y Y ü Ü
