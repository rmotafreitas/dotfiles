    key <AB04> { type[Group1] = "ALPHABETIC", [ v, V ] };  // v V - -
    key <AB05> { type[Group1] = "ALPHABETIC", [ b, B ] };  // b B - -
    key <AB06> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ n, N, ntilde, Ntilde ] };  // n N ñ Ñ
    key <AB07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ m, M, mu, NoSymbol ] };  // m M µ -
    key <AB08> { type[Group1] = "FOUR_LEVEL", [ comma, less, ccedilla, Ccedilla ] };  // , < ç Ç
    key <AB09> { type[Group1] = "TWO_LEVEL", [ period, greater ] };  // . > - -
    key <AB10> { type[Group1] = "FOUR_LEVEL", [ slash, question, questiondown, NoSymbol ] };  // / ? ¿ -
    key <LSGT> { type[Group1] = "TWO_LEVEL", [ backslash, bar ] };  // \ | - -
};
