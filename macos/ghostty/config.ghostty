# Theme
# T3 Chat (themes/t3-chat), following the system light/dark appearance.
theme = light:T3 Chat Light,dark:T3 Chat Dark
font-family = MesloLGS Nerd Font Mono
font-size = 14
background-opacity = 0.92
# frameless — very clean
window-decoration = auto
macos-window-buttons = visible
cursor-style = block
shell-integration = zsh
# Over SSH, install Ghostty's terminfo on the server and fall back to xterm-256color if that
# fails. Without this the server does not know TERM=xterm-ghostty and zsh garbles typing.
shell-integration-features = ssh-env,ssh-terminfo
